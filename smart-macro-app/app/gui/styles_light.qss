/* ============================================================
   Smart Macro Station — Light Mode
   ============================================================ */

/* --- Global --- */
QMainWindow, QWidget {
    background-color: #FFFFFF;
    color: #1a1a2e;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget#sidebar {
    background-color: #FAFBFC;
    min-width: 260px;
    max-width: 260px;
}

QWidget#contentArea {
    background-color: #F5F5F7;
}

/* --- Labels --- */
QLabel {
    color: #1a1a2e;
    background: transparent;
}

QLabel#heading {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a2e;
    letter-spacing: -0.5px;
}

QLabel#subheading {
    font-size: 14px;
    color: #6b7280;
    line-height: 20px;
}

QLabel#sectionLabel {
    font-size: 10px;
    font-weight: 600;
    color: #9ca3af;
    letter-spacing: 1.5px;
}

QLabel#fieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #4b5563;
}

QLabel#statusText {
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
}

QLabel#logoTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a2e;
    letter-spacing: -0.3px;
}

QLabel#logoSubtitle {
    font-size: 11px;
    color: #9ca3af;
    font-weight: 400;
}

/* --- Hero Banner --- */
QFrame#heroBanner {
    background-color: #EEF2FF;
    border: 1px solid #C7D2FE;
    border-radius: 14px;
}

QLabel#heroWelcome {
    font-size: 20px;
    font-weight: 700;
    color: #312E81;
}

QLabel#heroDesc {
    font-size: 14px;
    color: #4338CA;
    font-weight: 400;
}

/* --- Buttons --- */
QPushButton {
    background-color: #F3F4F6;
    color: #1a1a2e;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #E5E7EB;
    border-color: #D1D5DB;
}

QPushButton:pressed {
    background-color: #D1D5DB;
}

QPushButton:disabled {
    background-color: #F9FAFB;
    color: #9ca3af;
    border-color: #E5E7EB;
}

QPushButton#primary {
    background-color: #4F46E5;
    color: white;
    border: none;
}

QPushButton#primary:hover {
    background-color: #4338CA;
}

QPushButton#primary:pressed {
    background-color: #3730A3;
}

QPushButton#primary:disabled {
    background-color: #A5B4FC;
}

QPushButton#success {
    background-color: #059669;
    color: white;
    border: none;
}

QPushButton#success:hover {
    background-color: #047857;
}

QPushButton#danger {
    background-color: #DC2626;
    color: white;
    border: none;
}

QPushButton#danger:hover {
    background-color: #B91C1C;
}

QPushButton#ghost {
    background-color: transparent;
    color: #6b7280;
    border: none;
    font-weight: 500;
}

QPushButton#ghost:hover {
    background-color: #F3F4F6;
    color: #1a1a2e;
}

QPushButton#navButton {
    background-color: transparent;
    color: #6b7280;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    text-align: left;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #F3F4F6;
    color: #1a1a2e;
}

QPushButton#navButtonActive {
    background-color: #EEF2FF;
    color: #4F46E5;
    border: none;
    border-left: 3px solid #4F46E5;
    border-radius: 8px;
    text-align: left;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

/* --- Inputs --- */
QLineEdit {
    background-color: #F9FAFB;
    color: #1a1a2e;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    min-height: 22px;
}

QLineEdit:focus {
    border-color: #4F46E5;
    background-color: #FFFFFF;
}

QLineEdit:disabled {
    background-color: #F3F4F6;
    color: #9ca3af;
}

/* --- Text Areas --- */
QPlainTextEdit, QTextEdit {
    background-color: #F9FAFB;
    color: #1a1a2e;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 10px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}

QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #4F46E5;
}

QPlainTextEdit#terminal {
    background-color: #1E1B4B;
    color: #A5B4FC;
    border: 1px solid #312E81;
    border-radius: 8px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}

/* --- ComboBox --- */
QComboBox {
    background-color: #F9FAFB;
    color: #1a1a2e;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #D1D5DB;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #E5E7EB;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    selection-background-color: #EEF2FF;
    selection-color: #1a1a2e;
    padding: 4px;
}

/* --- CheckBox --- */
QCheckBox {
    color: #1a1a2e;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #D1D5DB;
    border-radius: 6px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #4F46E5;
    border-color: #4F46E5;
}

QCheckBox::indicator:hover {
    border-color: #4F46E5;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #E5E7EB;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 1px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 3px;
}

/* --- Slider --- */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #E5E7EB;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background-color: #4F46E5;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #4338CA;
}

QSlider::sub-page:horizontal {
    background-color: #4F46E5;
    border-radius: 3px;
}

/* --- Scrollbar --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9ca3af;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    border-radius: 4px;
    min-width: 30px;
}

/* --- Cards (QFrame) --- */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
}

QFrame#cardHeader {
    background: transparent;
    border-bottom: 1px solid #F3F4F6;
}

/* --- Status Badge --- */
QFrame#statusBadge {
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #1a1a2e;
    color: #F3F4F6;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* --- Separator --- */
QFrame#separator {
    background-color: #E5E7EB;
    max-height: 1px;
}

/* --- Icon container --- */
QFrame#iconFrame {
    background-color: #4F46E5;
    border-radius: 10px;
}
